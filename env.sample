# Environment template — copy to `.env` and set your values there.
#
#   cp env.sample .env
#
# `.env` is gitignored and is loaded automatically by direnv when you cd into
# the repo (see `.envrc`). This file is the committed catalog of every variable
# the repo understands; it holds defaults only, never real values.

# --- qmd (markdown search over ai-docs/) -------------------------------------

# llama.cpp GPU backend used for embedding, query expansion, and reranking.
# One of: auto | metal | vulkan | cuda | false   (false = CPU only)
QMD_LLAMA_GPU=auto

# Models qmd builds the index with. These are read once, when
# .claude/scripts/qmd-setup.sh creates the project index, and are then written
# into .qmd/index.yml — that file is what qmd reads afterwards, because its
# config takes precedence over these variables. Change a model here and re-run
# the setup script to apply it; qmd does not expand variables inside index.yml.
#
# Changing the embedding model invalidates every stored vector: its dimension
# is baked into the index, so a switch means a full re-embed of ai-docs/
# (`qmd embed -f`). Worktrees always inherit the models recorded in the project
# index rather than these values, so a seeded worktree can never disagree with
# the vectors it was seeded from.
#
# Leave unset to accept qmd's own defaults, which are much smaller and faster
# but noticeably weaker: embeddinggemma-300M (768d) and Qwen3-Reranker-0.6B.
QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-8B-GGUF/Qwen3-Embedding-8B-Q8_0.gguf
QMD_RERANK_MODEL=hf:giladgd/Qwen3-Reranker-4B-GGUF/Qwen3-Reranker-4B.Q8_0.gguf
QMD_GENERATE_MODEL=hf:tobil/qmd-query-expansion-1.7B-gguf/qmd-query-expansion-1.7B-q8_0.gguf
